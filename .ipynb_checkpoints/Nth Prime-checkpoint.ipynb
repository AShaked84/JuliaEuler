   ],
   "source": [
    "function nth_prime(num)\n",
    "    i = 0\n",
    "    counter = 0\n",
    "\n",
    "    while counter < num\n",
    "        i += 1\n",
    "        isprime(i) && (counter += 1)\n",
    "    end\n",
    "\n",
    "    return i\n",
    "end        "
   ]
  },
