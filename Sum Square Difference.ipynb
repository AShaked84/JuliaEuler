   "source": [
    "function sum_square_difference(max_num)\n",
    "    sqrsum = 0\n",
    "    sumsqr = 0\n",
    "\n",
    "    for i in 1:max_num\n",
    "        sqrsum += i*i\n",
    "        sumsqr += i\n",
    "    end\n",
    "\n",
    "    return sumsqr*sumsqr - sqrsum\n",
    "end"
   ]
  },
